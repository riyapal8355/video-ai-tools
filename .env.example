# VidoAI Environment Variables
# Active Database URL (SQLite for local zero-dependency development; switch to postgresql:// for production)
DATABASE_URL="file:./dev.db"

# JWT Auth Secret
JWT_SECRET="vidoai-production-super-secure-jwt-secret-key-32chars"

# S3 / Cloudflare R2 Storage (leave mock for local dev)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="vidoai-assets"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_DOMAIN=""

# Redis (optional: in-memory queue fallback runs when empty)
REDIS_URL=""

# AI Provider API Keys (optional for dev: high quality built-in fallback runs when empty)
OPENAI_API_KEY=""
ELEVENLABS_API_KEY=""
HEYGEN_API_KEY=""

# Stripe Billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
